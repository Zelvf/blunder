# Strongly recommended for production. Server-only; never exposed to the browser.
# The fallback public mainnet endpoint is rate-limited and has no SLA.
SOLANA_RPC_URL=https://your-private-mainnet-rpc.example

# Optional. Shown in the app navigation after you create the repository.
NEXT_PUBLIC_GITHUB_URL=https://github.com/Zelvf/blunder

# Optional. Used as the canonical base for generated social metadata.
NEXT_PUBLIC_SITE_URL=https://blunder-eta.vercel.app
